# Copy to .env and fill in real values. Never commit the populated .env file.

# Referenced by configs/full-example.yaml's airflow.auth_token (source: env).
AIRFLOW_TOKEN=

# Standard Google Application Default Credentials path, if not using
# workload identity / metadata-server credentials.
GOOGLE_APPLICATION_CREDENTIALS=

# Only needed if configs/*.yaml references gcp_secret_manager or
# azure_key_vault secrets and you are running outside their native
# identity environment (GCE/GKE metadata server, Azure Managed Identity).
